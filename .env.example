# ── GravitonForge Quasar demo — environment template ──
# Copy to `.env` and fill locally. NEVER commit the real .env.
# Private keys live in a secure element or local keystore, never here.

# API gateway
QUASAR_API_HOST=127.0.0.1
QUASAR_API_PORT=8000

# Local dev: allow Vite console origin (default on; set QUASAR_ENABLE_CORS=0 to disable)
QUASAR_ENABLE_CORS=1
QUASAR_CORS_ORIGIN=http://localhost:5173

# Dev-only hooks for console propagation-failure demo (signer swap; not for production)
QUASAR_ENABLE_DEV_HOOKS=1

# LLM narrator (read-only over ledger + policy; never in the decision path)
# Provider-agnostic. Key is read from the environment at runtime, never hardcoded.
QUASAR_LLM_API_KEY=
QUASAR_LLM_MODEL=

# Attestation key custody
# software  -> Ed25519 in process (demo default)
# secure_element -> ATECC608 / TPM 2.0 dev board (protocol identical; custody changes)
QUASAR_KEY_CUSTODY=software

# Clearance authority (Ed25519 private key, 32-byte hex). Leave empty to generate
# an ephemeral demo key at startup — not persisted across restarts. Never log this.
QUASAR_CLEARANCE_AUTHORITY_KEY_HEX=

# Site authority (Ed25519 private key, 32-byte hex). Leave empty to generate
# an ephemeral demo key at startup — not persisted across restarts. Never log this.
QUASAR_SITE_AUTHORITY_KEY_HEX=
